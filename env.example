# =============================================================================
# GOTALL MVP — ENVIRONMENT VARIABLES REFERENCE
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git. Add .env to your .gitignore.
# All keys marked [REQUIRED] must be present for the app to run.
# Keys marked [TESTING] are safe to use with free-tier test credentials.
# Keys marked [PROD ONLY] are not needed during local development.
# =============================================================================


# -----------------------------------------------------------------------------
# SUPABASE — Database, Auth, and File Storage
# Used for: user profiles, daily logs, stretch content, auth sessions
# Free tier: up to 50,000 MAU and 500MB storage
# How to get: https://supabase.com → New Project → Settings → API
# -----------------------------------------------------------------------------

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co          # [REQUIRED] Your Supabase project URL
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here                       # [REQUIRED] Public anon key (safe to expose in client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here                   # [PROD ONLY] Never expose this on client. For server-side admin tasks only.


# -----------------------------------------------------------------------------
# GOOGLE GEMINI AI — 1-Tap AI Growth Advisor
# Used for: generating 3 personalized daily tips (single REST call per tap)
# Model: gemini-1.5-flash (fastest, cheapest — ~₹0.10 per call)
# Free tier: 15 RPM, 1M tokens/day on free tier — enough for all testing
# How to get: https://aistudio.google.com/app/apikey
# Cost at scale: Pay-as-you-go. Estimate ₹150–₹300/month at MVP scale.
# Note: Use EXPO_PUBLIC_ prefix only if calling from client directly.
#       For production, route through a Supabase Edge Function to hide the key.
# -----------------------------------------------------------------------------

EXPO_PUBLIC_GEMINI_API_KEY=your-gemini-api-key-here                    # [REQUIRED] [TESTING] Free tier is sufficient for dev & testing
GEMINI_MODEL=gemini-1.5-flash                                          # [REQUIRED] Do not change for MVP. Flash is fastest + cheapest.


# -----------------------------------------------------------------------------
# REVENUECAT — In-App Subscription & Paywall
# Used for: Monthly / Quarterly / Annual subscription management
# Handles: Apple App Store IAP + Google Play Billing automatically
# Free tier: ₹0 until app revenue exceeds $2,500/month (~₹2.1 Lakhs)
# How to get: https://app.revenuecat.com → New Project → API Keys
# Testing: Use RevenueCat sandbox mode + Google Play test accounts
# -----------------------------------------------------------------------------

EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_your-revenuecat-android-key    # [REQUIRED] Android public SDK key from RevenueCat dashboard
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_your-revenuecat-ios-key            # [PROD ONLY] Only needed when building iOS. Not required for Android MVP.


# -----------------------------------------------------------------------------
# RAZORPAY — Payment Gateway & Direct Checkout (Testing & Web/APK)
# Used for: Direct UPI, Cards, Netbanking checkout testing in MVP
# How to get: https://dashboard.razorpay.com → Settings → API Keys → Generate Test Key
# -----------------------------------------------------------------------------
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id                        # [TESTING] Razorpay Key ID (rzp_test_...)
RAZORPAY_KEY_SECRET=your_razorpay_secret                                # [TESTING] Razorpay Key Secret

# -----------------------------------------------------------------------------
# EXPO / EAS BUILD — App Build & OTA Updates
# Used for: Production APK/AAB builds via `eas build -p android`
# How to get: https://expo.dev → Account Settings → Access Tokens
# Not needed for local `npx expo start` development
# -----------------------------------------------------------------------------

EXPO_TOKEN=your-expo-access-token                                      # [PROD ONLY] Only required for EAS cloud builds, not local dev


# -----------------------------------------------------------------------------
# APP CONFIG — Non-secret app-level constants
# These are safe to commit if they contain no keys.
# -----------------------------------------------------------------------------

EXPO_PUBLIC_APP_NAME=GoTall                                            # Display name of the app
EXPO_PUBLIC_APP_ENV=development                                        # Options: development | staging | production
EXPO_PUBLIC_SUPPORT_EMAIL=support@yourapp.com                          # Shown in profile/settings screens


# =============================================================================
# TESTING CHECKLIST — What you need running before first launch
# =============================================================================
# [ ] Supabase project created, SQL schema executed (profiles, daily_logs, stretches)
# [ ] Supabase Auth enabled (Email provider minimum)
# [ ] Supabase Storage bucket created: "stretch-media" (public read)
# [ ] Gemini API key created and tested with a raw curl call
# [ ] RevenueCat project created with Android app added
# [ ] RevenueCat products configured (match Google Play product IDs)
# [ ] Google Play Console account created ($25 one-time) — needed for IAP testing
# [ ] .env file created from this template with all [REQUIRED] keys filled
# =============================================================================
