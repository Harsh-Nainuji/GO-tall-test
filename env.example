# =============================================================================
# GOTALL MVP — ENVIRONMENT VARIABLES REFERENCE
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git. Add .env to your .gitignore.
# All keys marked [REQUIRED] must be present for the app to run.
# Keys marked [TESTING] are safe to use with free-tier test credentials.
# Keys marked [PROD ONLY] are not needed during local development.
# =============================================================================


# -----------------------------------------------------------------------------
# SUPABASE — Database, Auth, and File Storage
# Used for: user profiles, daily logs, stretch content, auth sessions
# Free tier: up to 50,000 MAU and 500MB storage
# How to get: https://supabase.com → New Project → Settings → API
# -----------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co          # [REQUIRED] Your Supabase project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here                       # [REQUIRED] Public anon key (safe to expose in client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here                   # [PROD ONLY] Never expose this on client.
SUPABASE_PROJECT_ID=your-project-id                                    # [OPTIONAL] Supabase reference id
SUPABASE_DB_PASSWORD=your-db-password                                  # [OPTIONAL] Supabase DB password

# Expo compatibility aliases
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co          # [REQUIRED]
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here                       # [REQUIRED]


# -----------------------------------------------------------------------------
# GOOGLE GEMINI AI — Dr. Jack Clinical Growth Advisor
# Used for: generating personalized pediatric clinical growth tips
# Model: gemini-1.5-flash (Fast, accurate, cost-effective with 1,500 free daily queries)
# Free tier: 15 RPM, 1M tokens/day on free tier — enough for all testing
# How to get: https://aistudio.google.com/app/apikey
# -----------------------------------------------------------------------------

GEMINI_API_KEY=your-gemini-api-key-here                                # [REQUIRED] [TESTING] Free tier sufficient
GEMINI_MODEL=gemini-1.5-flash                                          # [REQUIRED]
NEXT_PUBLIC_GEMINI_API_KEY=your-gemini-api-key-here                    # Next.js web client key
NEXT_PUBLIC_GEMINI_MODEL=gemini-1.5-flash                              # Next.js model
EXPO_PUBLIC_GEMINI_API_KEY=your-gemini-api-key-here                    # Expo mobile client key
EXPO_PUBLIC_GEMINI_MODEL=gemini-1.5-flash                              # Expo model


# -----------------------------------------------------------------------------
# REVENUECAT — In-App Subscription & Paywall
# Used for: Monthly / Quarterly / Annual subscription management
# Handles: Apple App Store IAP + Google Play Billing automatically
# Free tier: ₹0 until app revenue exceeds $2,500/month (~₹2.1 Lakhs)
# How to get: https://app.revenuecat.com → New Project → API Keys
# -----------------------------------------------------------------------------

NEXT_PUBLIC_REVENUECAT_KEY=test_your-revenuecat-key                    # [TESTING]
EXPO_PUBLIC_REVENUECAT_KEY=test_your-revenuecat-key                    # [TESTING]
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_your-revenuecat-android-key    # [REQUIRED] Android public SDK key
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_your-revenuecat-ios-key            # [PROD ONLY] iOS public SDK key


# -----------------------------------------------------------------------------
# RAZORPAY — Payment Gateway & Direct Checkout (Testing & Web/APK)
# Used for: Direct UPI, Cards, Netbanking checkout testing in MVP
# How to get: https://dashboard.razorpay.com → Settings → API Keys → Generate Test Key
# -----------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id                        # [TESTING] Razorpay Key ID
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id                        # [TESTING]
RAZORPAY_KEY_SECRET=your_razorpay_secret                                # [TESTING] Razorpay Key Secret


# -----------------------------------------------------------------------------
# EXPO / EAS BUILD — App Build & OTA Updates
# Used for: Production APK/AAB builds via `eas build -p android`
# -----------------------------------------------------------------------------
EXPO_TOKEN=your-expo-access-token                                      # [PROD ONLY] For EAS cloud builds


# -----------------------------------------------------------------------------
# APP CONFIG — Non-secret app-level constants
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=GoTall                                            # Display name of the app
EXPO_PUBLIC_APP_NAME=GoTall
NEXT_PUBLIC_APP_ENV=production                                         # development | staging | production
EXPO_PUBLIC_APP_ENV=production
NEXT_PUBLIC_SUPPORT_EMAIL=support@gotall.app
EXPO_PUBLIC_SUPPORT_EMAIL=support@gotall.app
