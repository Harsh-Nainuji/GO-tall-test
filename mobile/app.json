{
  "expo": {
    "name": "GoTall",
    "slug": "gotall",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "gotall",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gotall.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "GoTall uses speech features to read personalized clinical stature guidance aloud.",
        "NSMicrophoneUsageDescription": "GoTall uses microphone access for stature inquiry interactions.",
        "NSCameraUsageDescription": "GoTall may use your camera to track posture alignment and spinal decompression.",
        "NSPhotoLibraryUsageDescription": "GoTall accesses your photo library to save and track growth milestone progress."
      }
    },
    "android": {
      "package": "com.gotall.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.VIBRATE",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font",
      "expo-splash-screen",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "aa82005f-4831-45b5-88c7-517fec06993d"
      }
    },
    "owner": "harsh-n"
  }
}
