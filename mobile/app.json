{
  "expo": {
    "name": "Tallgrame",
    "slug": "gotall",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "tallgrame",
    "userInterfaceStyle": "automatic",
    "jsEngine": "hermes",
    "newArchEnabled": true,
    "privacy": "unlisted",
    "platforms": ["ios", "android", "web"],
    "githubUrl": "",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tallgrame.app",
      "buildNumber": "3",
      "jsEngine": "hermes",
      "associatedDomains": ["applinks:tallgrame.app"],
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Tallgrame uses speech features to read personalized clinical stature guidance aloud.",
        "NSMicrophoneUsageDescription": "Tallgrame uses microphone access for stature inquiry interactions.",
        "NSCameraUsageDescription": "Tallgrame may use your camera to track posture alignment and spinal decompression.",
        "NSPhotoLibraryUsageDescription": "Tallgrame accesses your photo library to save and track growth milestone progress.",
        "NSUserNotificationUsageDescription": "Tallgrame sends reminders for your sleep and stretch routines.",
        "NSHealthShareUsageDescription": "Tallgrame reads health data to personalize your growth plan.",
        "NSHealthUpdateUsageDescription": "Tallgrame writes workout and sleep data to Apple Health.",
        "NSFaceIDUsageDescription": "Tallgrame uses Face ID for secure sign-in.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        }
      }
    },
    "android": {
      "package": "com.tallgrame.app",
      "versionCode": 3,
      "jsEngine": "hermes",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.VIBRATE",
        "android.permission.CAMERA",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.USE_FINGERPRINT",
        "android.permission.USE_BIOMETRIC",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "tallgrame"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "tallgrame.app"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font",
      "expo-splash-screen",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "aa82005f-4831-45b5-88c7-517fec06993d"
      },
      "androidGoogleServicesNote": "Add google-services.json from Firebase before production build"
    },
    "owner": "harsh-n"
  }
}
